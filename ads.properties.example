# Copy to ads.properties (git-ignored) and put your real AdMob IDs there.
# Release builds use these. Debug builds ALWAYS use Google's test IDs, whatever is here.
# If ads.properties is missing, release builds use Google's test IDs for everything (never mixed with real IDs).
# (App ID uses "~", ad unit IDs use "/").
admob.appId=ca-app-pub-XXXXXXXXXXXXXXXX~NNNNNNNNNN
admob.bannerId=ca-app-pub-XXXXXXXXXXXXXXXX/NNNNNNNNNN
# Leave blank to disable interstitials entirely.
admob.interstitialId=
# Optional comma-separated test device IDs passed to RequestConfiguration.setTestDeviceIds.
admob.testDeviceIds=
